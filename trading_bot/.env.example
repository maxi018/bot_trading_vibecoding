# Copiar a /etc/quantbot/quantbot.env (chmod 600, owner quantbot). NUNCA commitear.
# API key: SOLO permisos de trading. SIN permiso de retiro. Con whitelist de IP del VPS.
QB_API_KEY=
QB_API_SECRET=
